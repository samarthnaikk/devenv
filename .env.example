# Devenv uses OpenCode as the AI backend by default.
# OpenCode Zen credentials are stored locally (~/.local/share/opencode/auth.json).
# No .env variables are required — everything works out of the box.
#
# TUI defaults (applied on first run; persisted state overrides them):
#   answer model    = opencode/longcat-2.5-preview-free
#   selector model  = opencode/longcat-2.5-preview-free
#   session selector = enabled
# Use /assistant-model in the TUI to change the answer/selector models.

# Optional overrides:
# OPENCODE_MODEL=opencode/claude-sonnet-4
# DEVENV_AVAILABLE_MODELS=opencode/claude-sonnet-4,opencode/deepseek-v4-flash-free
# DEVENV_OLLAMA_MODEL=qwen2.5:3b
# DEVENV_OLLAMA_BASE_URL=http://127.0.0.1:11434
# DEVENV_OLLAMA_NUM_CTX=4096
# DEVENV_OLLAMA_NUM_THREAD=4
# DEVENV_OLLAMA_KEEP_ALIVE=2m

# Retrieval-selection layer (off by default; the engine is used unchanged).
# DEVENV_SESSION_SELECTOR=1
# DEVENV_SESSION_SELECTOR_SHADOW=1
# DEVENV_SESSION_SELECTOR_MODEL=opencode/longcat-2.5-preview-free
# DEVENV_SESSION_SELECTOR_PERMUTATIONS=2
# DEVENV_SESSION_SELECTOR_MAX_ATTEMPTS=2
# DEVENV_SESSION_SELECTOR_MIN_CONFIDENCE=0.4
# DEVENV_SESSION_SELECTOR_RECALL_FLOOR=hard   # off | soft | hard
# DEVENV_SESSION_SELECTOR_RECALL_FLOOR_K=3
# DEVENV_SESSION_SELECTOR_RECALL_FLOOR_WIDE_K=6
# DEVENV_SESSION_SELECTOR_TIMEOUT=300
# DEVENV_SESSION_SELECTOR_MAX_SELECTED=5
# DEVENV_MODEL_CACHE=~/.cache/devenv/opencode_models.json
# Deterministic project gate backstop: off | demote | filter
# DEVENV_SESSION_PROJECT_GATE=demote

# Answer formatter layer (on by default): formats retrieved evidence into a
# clean, structured answer via the model. Set to 0 to return the raw response.
# DEVENV_ANSWER_FORMATTER=1
